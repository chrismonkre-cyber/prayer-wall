{
  "name": "Testimony",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the person sharing the testimony"
    },
    "email": {
      "type": "string",
      "description": "Email address (optional)"
    },
    "title": {
      "type": "string",
      "description": "Testimony title"
    },
    "story": {
      "type": "string",
      "description": "The testimony story"
    },
    "permission_to_share": {
      "type": "boolean",
      "default": false,
      "description": "Whether the submitter gave permission to share"
    },
    "approved": {
      "type": "boolean",
      "default": false,
      "description": "Admin-approved for public display"
    },
    "isPublic": {
      "type": "boolean",
      "default": false,
      "description": "Whether the testimony is publicly visible"
    }
  },
  "required": [
    "title",
    "story"
  ]
}